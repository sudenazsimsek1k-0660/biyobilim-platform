# ============================================
# BİYOBİLİM — Ortam Değişkenleri (örnek dosya)
# Gerçek değerleri .env.local dosyasına kopyalayın; .env.local asla commit edilmez.
# ============================================

# Supabase — Proje Ayarları > API bölümünden alınır
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Yalnızca sunucu tarafında kullanılır (server actions, route handlers). ASLA istemciye sızdırılmaz.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Biyobilim

# E-posta altyapısı (örn. Resend) — bildirim/onay e-postaları için
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Biyobilim <bildirim@biyobilim.org>"
ADMIN_NOTIFICATION_EMAIL=iletisim@biyobilim.org
